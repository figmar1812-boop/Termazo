# Copia este archivo como .env y llena el valor real.
# Nunca subas el archivo .env (con tus datos reales) a GitHub — ya está
# excluido en .gitignore.

# Cadena de conexión a tu base de datos PostgreSQL (Neon, Supabase, etc.)
DATABASE_URL="postgresql://usuario:password@host/basededatos?sslmode=require"

# Mercado Pago — sácalos desde tu panel: https://www.mercadopago.com.mx/developers/panel
# Empieza con las credenciales de PRUEBA (Test) hasta que todo funcione bien,
# y cámbialas por las de producción solo cuando estés listo para vender de verdad.
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="TEST-xxxxxxxxxxxxxxxxxxxxxxxxx"

# URL pública de tu sitio (sin diagonal al final). En local: http://localhost:3000
# En Vercel: la URL real de tu proyecto, ej. https://termazo.vercel.app
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Resend — para los emails automáticos. Sácalo desde: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
# Correo remitente — debe ser de un dominio que verifiques en Resend antes de
# usarlo en producción. Mientras tanto puedes dejar el que trae Resend de prueba.
EMAIL_FROM="Termazo <pedidos@termazo.mx>"
